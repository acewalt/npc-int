{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acewalt.github.io/npc-int/contracts/commonsense.v1.schema.json",
  "title": "NPC-INT commonsense pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "language", "description", "relations"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"const": 1},
    "language": {"const": "es"},
    "description": {"type": "string", "minLength": 12},
    "relations": {
      "type": "array",
      "minItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relation"}
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "object", "confidence", "domain"],
      "properties": {
        "subject": {"type": "string", "minLength": 2},
        "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "object": {"type": "string", "minLength": 2},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "domain": {
          "type": "string",
          "enum": ["juegos", "vida_cotidiana", "causalidad", "objetos", "social"]
        }
      }
    }
  }
}
