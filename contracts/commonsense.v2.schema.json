{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acewalt.github.io/npc-int/contracts/commonsense.v2.schema.json",
  "title": "NPC-INT Commonsense Pack v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "language", "relations"],
  "properties": {
    "version": {"const": 2},
    "language": {"type": "string", "minLength": 2},
    "name": {"type": "string"},
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    }
  },
  "$defs": {
    "conceptId": {
      "type": "string",
      "pattern": "^concept:[a-z0-9_]+:[a-z0-9_]+$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {"type": "string", "minLength": 2},
        "sourceId": {"type": ["string", "null"]},
        "rawWeight": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "predicate", "object", "confidence", "domain", "provenance"],
      "properties": {
        "subject": {"$ref": "#/$defs/conceptId"},
        "predicate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "object": {"$ref": "#/$defs/conceptId"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "domain": {
          "type": "string",
          "enum": ["juegos", "vida_cotidiana", "causalidad", "objetos", "social"]
        },
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
