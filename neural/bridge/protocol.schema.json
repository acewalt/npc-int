{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acewalt.github.io/npc-int/neural/bridge/protocol.schema.json",
  "title": "npc-int neural bridge protocol",
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "enum": ["utterance", "interpret", "reflect", "free"]
    },
    "prompt": {"type": "string"},
    "maxTokens": {"type": "integer", "minimum": 1, "maximum": 512},
    "temperature": {"type": "number", "minimum": 0},
    "topK": {"type": "integer", "minimum": 1},
    "context": {
      "type": "object",
      "properties": {
        "identity": {"type": "object"},
        "mentalState": {"type": "object"},
        "memories": {"type": "array"},
        "goals": {"type": "array"},
        "decision": {"type": "object"},
        "knowledge": {"type": "array"}
      },
      "additionalProperties": true
    }
  },
  "required": ["task"],
  "additionalProperties": true
}
